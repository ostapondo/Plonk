<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- Simplified Chinese uses the other category for every count. -->
<dict>
	<key>zoneSet.zoneCount %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@zones@</string>
		<key>zones</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>other</key>
			<string>%lld 个分屏</string>
		</dict>
	</dict>
	<key>workspaces.appCount %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@apps@</string>
		<key>apps</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>other</key>
			<string>%lld 个应用</string>
		</dict>
	</dict>
	<key>workspaces.windowCount %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@windows@</string>
		<key>windows</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>other</key>
			<string>%lld 个窗口</string>
		</dict>
	</dict>
	<key>workspaces.monitorCount %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@monitors@</string>
		<key>monitors</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>other</key>
			<string>%lld 台显示器</string>
		</dict>
	</dict>
	<key>app.agentCount %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@agents@</string>
		<key>agents</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>other</key>
			<string>%lld 个 Agent</string>
		</dict>
	</dict>
</dict>
</plist>
