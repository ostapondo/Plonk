{
  "name": "plonk-mcp",
  "version": "0.2.0",
  "mcpName": "io.github.ostapondo/plonk",
  "description": "MCP server for Plonk — ten Mac menu bar utilities your AI agent can drive. Window layouts and zones, workspaces, keep-awake, screenshots and on-device OCR.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ostapondo/plonk.git",
    "directory": "mcp"
  },
  "homepage": "https://github.com/ostapondo/plonk#readme",
  "bugs": "https://github.com/ostapondo/plonk/issues",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "macos",
    "window-manager",
    "workspaces",
    "screenshots"
  ],
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist"
  ],
  "bin": {
    "plonk-mcp": "dist/server.js",
    "plonk": "dist/cli.js"
  },
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsc && node --test test/*.test.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "typescript": "^5.5.0"
  }
}
